<ETHERNETKRL>
  <CONFIGURATION>
    <EXTERNAL>
      <TYPE>Client</TYPE>
      <IP>192.168.1.100</IP>
      <PORT>59001</PORT>
    </EXTERNAL>
    <INTERNAL>
      <BUFFERING Limit="10" />
      <ALIVE Set="True" />
    </INTERNAL>
  </CONFIGURATION>
  <RECEIVE>
    <XML>
      <ELEMENT Tag="RobotTask/Command" Type="STRING" />
      <ELEMENT Tag="RobotTask/TargetPos/X" Type="REAL" />
      <ELEMENT Tag="RobotTask/TargetPos/Y" Type="REAL" />
      <ELEMENT Tag="RobotTask/TargetPos/Z" Type="REAL" />
    </XML>
  </RECEIVE>
  <SEND>
    <XML>
      <ELEMENT Tag="RobotStatus/ActualPos/X" Type="REAL" />
      <ELEMENT Tag="RobotStatus/IsReady" Type="BOOL" />
    </XML>
  </SEND>
</ETHERNETKRL>
