# Geliştirme dosyaları - VS Code'un pakete dahil etmemesi gereken dosyalar
.vscode/**
.gitignore
tsconfig.json
**/tsconfig.json
**/tsconfig.tsbuildinfo

# Demo examples (only for GitHub, not needed in package)
examples/**

# Kaynak dosyalar (derlenmış JS dosyaları kullanılacak)
