&ACCESS RVP
&REL 1
&COMMENT Control Flow Analyzer Benchmark Program
DEF flowchart_demo()
  ; ========================================================
  ; FLOWCHART & CFG VISUALIZER BENCHMARK
  ; Tests: Mermaid graph rendering, nested branch conditions,
  ; multi-exit loops, and SWITCH/CASE pathways
  ; ========================================================
  DECL INT nCycleIndex
  DECL INT nQualityGrade
  DECL REAL rTemperature

  nCycleIndex = 1
  nQualityGrade = 0
  rTemperature = 84.5

  WHILE nCycleIndex <= 5
    IF rTemperature > 100.0 THEN
      ; High thermal alarm branch
      $OUT[8] = TRUE
      HALT
    ELSE
      IF rTemperature > 80.0 THEN
        nQualityGrade = 1
      ELSE
        nQualityGrade = 2
      ENDIF
    ENDIF

    SWITCH nQualityGrade
      CASE 1
        nCycleIndex = nCycleIndex + 1
      CASE 2
        nCycleIndex = nCycleIndex + 2
      DEFAULT
        nCycleIndex = nCycleIndex + 3
    ENDSWITCH
  ENDWHILE
END
