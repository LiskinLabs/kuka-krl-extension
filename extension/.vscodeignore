# VS Code & Git configuration
.vscode/**
.gitignore
tsconfig.json
**/tsconfig*.json
**/tsconfig.tsbuildinfo

# Demo examples
examples/**
demo-workspace/**

# Source & TypeScript files
**/src/**
**/*.ts
**/*.d.ts
**/*.map
**/*.log

# Unbundled compiler artifacts (only bundle entries client/out/main.js & server/out/core.js are needed)
client/out/**
!client/out/main.js
server/out/**
!server/out/core.js
client/package.json
server/package.json

# Documentation
*.pdf
*.md
!README.md
!readme.md

# Package & Lock files
*.vsix
check_tmp.js
eslint.config.js
**/package-lock.json
esbuild.js
.prettierrc

# Node modules
node_modules/**
**/node_modules/**

# Test files & scripts
tests/**
test_krl_extension.src
validate-json.js
*.test.js

# Secrets, Environment & Database files
.env*
.dev.vars*
*.sql
*.tmp
*.bak
*.zip
*.log
.github/**
.agents/**
.system_generated/**

# Allow media assets for offline README rendering inside VS Code
!media/*.gif
!media/*.png
!media/*.svg
!logo.png
!logo.svg

