**/*.ts
!**/*.d.ts

# Haritalar ve günlükler
**/*.map
**/*.log

# Belgeler
*.pdf
*.md
!readme.md

# Eski VSIX dosyaları
*.vsix

# Gereksiz dosyalar
check_tmp.js
eslint.config.js
**/package-lock.json

# node_modules
node_modules/**
**/node_modules/**

# Test files and scripts
tests/**
test_krl_extension.src
validate-json.js
*.test.js

# Heavy demo GIFs (hosted externally in README)
media/**/*.gif
esbuild.js
.prettierrc
